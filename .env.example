# LINE 設定
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# OpenAI 設定
OPENAI_API_KEY=your_openai_api_key_here

# 資料庫設定
DATABASE_URL=postgresql://username:password@localhost:5432/line_secretary
# 或使用 MongoDB (如果偏好 MongoDB)
# MONGODB_URI=mongodb://localhost:27017/line_secretary

# 群組與管理員設定
TARGET_GROUP_IDS=C1234567890abcdef,C2345678901bcdefg
ADMIN_USER_IDS=U1234567890abcdef,U2345678901bcdefg

# 後台授權設定（二擇一）
ADMIN_TOKEN=your_secure_admin_token_here
# 或使用 Basic Auth
# ADMIN_USER=admin
# ADMIN_PASS=your_secure_password

# 系統設定
TZ=Asia/Taipei
PORT=8000
RECENT_DAYS=7

# 開發環境
NODE_ENV=development
