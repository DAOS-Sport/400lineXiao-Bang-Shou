# LINE 設定
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# OpenAI 設定
OPENAI_API_KEY=your_openai_api_key_here

# 資料庫設定
DATABASE_URL=postgresql://username:password@localhost:5432/line_secretary
# 或使用 MongoDB (如果偏好 MongoDB)
# MONGODB_URI=mongodb://localhost:27017/line_secretary

# 群組與管理員設定
TARGET_GROUP_IDS=C1234567890abcdef,C2345678901bcdefg
ADMIN_USER_IDS=U1234567890abcdef,U2345678901bcdefg

# 後台授權設定（二擇一）
ADMIN_TOKEN=your_secure_admin_token_here
# 或使用 Basic Auth
# ADMIN_USER=admin
# ADMIN_PASS=your_secure_password

# 系統設定
TZ=Asia/Taipei
PORT=8000
RECENT_DAYS=7

# 公告精度控制（T001 新增）
# 強關鍵字嚴格模式：COMBO 關鍵字需 ≥25字 或有其他訊號才 rule_matched
ANNOUNCEMENT_STRICT_STRONG_KEYWORDS=false
# NORMAL 短語嚴格模式：一般公告需符合短語而非單字
ANNOUNCEMENT_STRICT_NORMAL_PHRASES=false
# AI 信心門檻（低於此值的非主管訊息 drop，預設 0.55）
ANNOUNCEMENT_AI_MIN_CONFIDENCE=0.55

# 服務監聽（T003 新增）
# 外部儀表板 webhook URL（空白則停用推送）
DASHBOARD_WEBHOOK_URL=
# webhook 簽名金鑰（HMAC-SHA256, header: X-Hub-Signature-256）
DASHBOARD_WEBHOOK_SECRET=
# 心跳推送間隔（毫秒，預設 300000 = 5分鐘）
DASHBOARD_HEARTBEAT_INTERVAL_MS=300000

# 開發環境
NODE_ENV=development
